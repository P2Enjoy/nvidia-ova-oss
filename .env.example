# @spec U6, H3.1 — modèle de fichier .env : TOUTES les variables du harnais.
# Copier en `.env` (`cp .env.example .env`) puis renseigner les valeurs réelles.
# Le vrai `.env` est ignoré par git et ne doit JAMAIS être committé : il porte des
# secrets. Ce fichier-ci n'en contient aucun — uniquement des exemples.
#
# Lecture (H3.1) : le harnais lit d'abord l'environnement du shell, puis `./.env`
# à défaut. Lignes `#` ignorées ; format `CLE=valeur`. Aucune valeur n'est
# journalisée. En mode `replay` (défaut des tests et du worker), AUCUNE variable
# n'est requise : la configuration pointe la pile locale de rejeu. En mode `live`,
# l'absence d'une variable requise est une erreur au démarrage qui la nomme (H3.3).

# ─────────────────────────────────────────────────────────────────────────────
# 1. Endpoint d'inférence (Ollama derrière proxy authentifiant) — REQUIS en live
# ─────────────────────────────────────────────────────────────────────────────

# URL de base de l'endpoint (API native sous /api, surface OpenAI sous /v1).
# Peut pointer l'origine directe OU le pont HTTPS 443 (infra/llm-proxy) quand la
# sortie réseau de l'environnement est limitée au port 443 — l'authentification
# traverse le pont telle quelle. Format : URL https://hôte[:port], sans slash
# final. Requis en live.
OLLAMA_HOST=https://inference.example.com

# Clé d'authentification, envoyée en `Authorization: Bearer …`.
# Format : chaîne opaque. Requis en live. SECRET — jamais committée.
OLLAMA_API_KEY=sk-ollama-xxxxxxxxxxxxxxxxxxxxxxxx

# Fenêtre de contexte demandée au serveur, en tokens (transmise en options.num_ctx).
# Le plafond réellement applicable est PAR CLÉ API, publié par le proxy dans le
# corps de son HTTP 413 (`max_context_tokens`, estimation majorée de 15 % — H3.2) :
# le budget utile vaut floor(contexte / 1,15) − AVO_NUM_PREDICT.
# Format : entier. Requis en live.
OLLAMA_CONTEXT_LENGTH=131072

# ─────────────────────────────────────────────────────────────────────────────
# 2. API ARC Prize (ARC-AGI-3) — REQUIS pour l'évaluation live uniquement
# ─────────────────────────────────────────────────────────────────────────────

# Clé d'accès, envoyée en en-tête `X-API-Key`. ATTENTION : jouer via l'API
# officielle PUBLIE un scorecard sur le compte du responsable (A2.3).
# Format : UUID. Requis pour le live ARC, inutile au reste. SECRET.
ARC_API_KEY=00000000-0000-0000-0000-000000000000

# Base de l'API ARC-AGI-3. Défaut selon le mode : API officielle en live, pile
# locale en rejeu — où le client REFUSE tout autre hôte (garde anti-publication).
# Format : URL. Facultatif.
#ARC_BASE_URL=http://127.0.0.1:8765

# ─────────────────────────────────────────────────────────────────────────────
# 3. Modèle et inférence — facultatif (défauts H3.1 entre parenthèses)
# ─────────────────────────────────────────────────────────────────────────────

# Nom du modèle servi par l'endpoint. Format : chaîne. (défaut : qwen3.6:35b)
#AVO_MODEL=qwen3.6:35b

# Raisonnement natif du modèle (`think` sur /api/chat — politique H12 : false par
# défaut, le raisonnement consommant le budget de sortie). Format : booléen.
#AVO_THINK=false

# Budget de sortie par appel (options.num_predict). Format : entier. (4096)
#AVO_NUM_PREDICT=4096

# Température d'échantillonnage. Format : réel borné. (0.7)
#AVO_TEMPERATURE=0.7

# Timeout d'un appel LLM, en secondes — le modèle peut raisonner plusieurs
# minutes sur les grands contextes. Format : entier. (900)
#AVO_TIMEOUT_S=900

# ─────────────────────────────────────────────────────────────────────────────
# 4. Budgets de contexte, d'outils et d'actions — facultatif
# ─────────────────────────────────────────────────────────────────────────────

# Seuil de continuation en contexte frais, en fraction du budget de prompt
# (H5.3). Format : réel dans ]0,1[. (0.85)
#AVO_CONTEXT_SOFT_RATIO=0.85

# Garde : nombre maximal d'appels d'outils par tour d'agent ; au-delà, le tour
# est clos par un message explicite (H7.2). Format : entier. (40)
#AVO_TOOL_STEPS_MAX=40

# Bornes d'actions d'environnement, par niveau et par jeu (H8.3) ; leur
# dépassement arrête proprement en nommant la borne. Format : entiers. (1000/5000)
#AVO_ACTIONS_MAX_NIVEAU=1000
#AVO_ACTIONS_MAX_JEU=5000

# Superviseur (H10) : actions sans progrès avant intervention, et nombre minimal
# d'actions entre deux interventions. Format : entiers. (60/30)
#AVO_SUP_STALL_ACTIONS=60
#AVO_SUP_COOLDOWN=30

# ─────────────────────────────────────────────────────────────────────────────
# 5. Artefacts — facultatif
# ─────────────────────────────────────────────────────────────────────────────

# Racine des workspaces de run (manifeste, transcripts, frames, lignée, rapport).
# Format : chemin. (runs/)
#AVO_RUNS_DIR=runs/

# Mode de contexte de la boucle agent (H15). transcript : historique complet,
# append-only (défaut, aucun changement de comportement). state : état structuré Σ,
# prompt borné en O(1) par tour — alternative configurable, pas un remplacement.
# Format : transcript | state. (transcript)
#AVO_CONTEXT_MODE=transcript

# Plafond de requêtes LLM simultanées par endpoint (H4.9) : le port public de
# l'endpoint tolère au plus 3 requêtes en parallèle ; l'excédent PATIENTE (file
# d'attente à jetons de fichiers) au lieu d'échouer en 500. 0 désactive.
# Format : entier >= 0. (3)
#AVO_LLM_MAX_CONCURRENT=3

# Répertoire des jetons de concurrence (H4.9). Pointer un chemin réellement
# partagé (volume commun) pour coordonner plusieurs processus ou sessions.
# Format : chemin. (<AVO_RUNS_DIR>/.llm-slots)
#AVO_LLM_SLOTS_DIR=runs/.llm-slots

# ─────────────────────────────────────────────────────────────────────────────
# 6. Outillage local (Makefile, pile compose, scripts) — facultatif
# NB : ces trois variables sont lues dans l'ENVIRONNEMENT DU SHELL par make et
# les scripts, pas dans ce fichier (make ne lit pas .env) : les passer sur la
# ligne de commande (`AVO_NO_DOCKER=1 make test-unit`) ou les exporter.
# ─────────────────────────────────────────────────────────────────────────────

# Mode dégradé sans Docker : tests sur l'hôte avec la stdlib seule, lint réduit,
# typecheck non exécuté (MASTER_PLAN §4). Format : définie = actif. (non définie)
#AVO_NO_DOCKER=1

# Ports publiés de la pile locale de rejeu. Format : entiers. (11435 / 8765)
#AVO_PORT_LLM_REPLAY=11435
#AVO_PORT_ARC_REPLAY=8765
